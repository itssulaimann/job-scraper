# Get from: https://console.apify.com/settings/integrations
APIFY_TOKEN=your_apify_api_token_here
# Optional second token — used automatically when the first hits its monthly usage limit
APIFY_TOKEN_FALLBACK=

# Get from: https://www.notion.so/my-integrations
NOTION_TOKEN=your_notion_integration_token_here

# Get from: https://brandfetch.com/dashboard → API Keys
BRANDFETCH_API_KEY=your_brandfetch_api_key_here
BRANDFETCH_CLIENT_ID=your_brandfetch_client_id_here

# Notion database IDs (set automatically by setup.py --schedule, or paste from Notion URLs)
COMPANIES_DB_ID=your_companies_database_id_here

# JSearch (Google for Jobs aggregate — LinkedIn, Indeed, Glassdoor, ...)
# Free tier: 200 credits/month, no credit card. One page of 10 results = 1 credit.
# Get from: https://app.openwebninja.com/api/jsearch
# Leave unset to skip the JSearch source entirely.
JSEARCH_API_KEY=your_jsearch_api_key_here

# SQLite (optional — override the default jobs.db location)
# SQLITE_DB_PATH=/path/to/your/jobs.db

# Careerjet (optional). The API validates the Referer header and rejects
# external domains with HTTP 401 — localhost works, so the default is fine
# unless you host this under a domain registered to a publisher account.
# CAREERJET_REFERER=https://localhost/jobfinder
# CAREERJET_AFFID=your_careerjet_affiliate_id
# ⚠️  Changing CAREERJET_AFFID rewrites every result URL, which defeats
#     URL-based dedup and re-adds the entire back catalogue. Set it once.

# Optional: override default Apify actor IDs if you find better ones
# APIFY_LINKEDIN_ACTOR=bebity/linkedin-jobs-scraper
# APIFY_XING_ACTOR=bebity/xing-jobs-scraper
