# ProductLab Jobs — configuration
#
# Every job source used by the public board is FREE and keyless, so the board
# runs with no configuration at all. Everything below is OPTIONAL.

# ── Web board ────────────────────────────────────────────────────────────────

# Override the SQLite path (default: jobs_<city>.db next to the code).
# SQLITE_DB_PATH=/path/to/jobs.db

# Gate the manual "Fetch new" button. Unset = manual fetching is disabled and
# the board refreshes from the scheduled scrape only. Set to a strong secret
# to enable it (validated server-side; never shipped to the browser).
# FETCH_PASSWORD=

# Rate-limit / body-cap tuning (sensible defaults live in security.py).
# RL_SCRAPE=5
# RL_AUDIT=20
# RL_API=120
# RL_GLOBAL=300
# MAX_BODY_BYTES=262144

# ── Optional scraper keys ─────────────────────────────────────────────────────

# JSearch (Google-for-Jobs aggregate). Metered free tier, ~200 credits/month.
# Leave unset to skip the JSearch source entirely.
# Get from: https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch
# JSEARCH_API_KEY=

# Careerjet validates the Referer header; localhost works by default. Only set
# these if you host under a domain registered to a Careerjet publisher account.
# Changing the affiliate id rewrites every result URL and breaks URL dedup.
# CAREERJET_REFERER=https://localhost/jobs
# CAREERJET_AFFID=

# ── Career-page LLM fallback (scrapers/scrapegraph.py) ─────────────────────────
# Only used when a career page can't be parsed structurally. Any one of:
# GROQ_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# SGAI_API_KEY=

# ── Post-scrape QA via the Claude CLI (optional) ───────────────────────────────
# Requires the `claude` binary on PATH. Cleans titles and flags mismatches on
# newly scraped rows only.
# CLAUDE_QA=0
# CLAUDE_BIN=claude
# CLAUDE_QA_MAX=120
# CLAUDE_QA_BATCH=12
# CLAUDE_QA_TIMEOUT=60
